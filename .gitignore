# ── Project-specific ──────────────────────────────────────────────────────────

# Generated audio models (large binary files downloaded at runtime)
audio_separator_models/

# User project directories (contain uploaded audio, images, and rendered videos)
# Each project has its own config.json, audio, images/, and output/ folder.
# Exclude everything except the base_images sample assets.
*/audio.*
*/vocals.mp3
*/instrumental.mp3
*/output/
*/images/
*/config.json
*/README.txt
projects/


# Rendered videos at root level (in case assembler writes here)
*.mp4

# Loop videos uploaded by users
loop_videos/

# Whisper model cache (downloaded to ~/.cache/whisper by default)
.cache/
